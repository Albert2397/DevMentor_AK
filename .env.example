# Copy to packages/app/.env.local for local development (the sandbox already provides DATABASE_URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devmentor
DATABASE_POOL_MAX=10
LOG_LEVEL=info
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set in production; leave unset locally to derive the URL from the request.
BETTER_AUTH_URL=
# Comma-separated hosts when there is no single URL (e.g. preview deployments).
BETTER_AUTH_ALLOWED_HOSTS=
BETTER_AUTH_TRUSTED_ORIGINS=
